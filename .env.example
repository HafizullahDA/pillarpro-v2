# ==============================================================================
# PillarPro Production & Development Environment Configuration
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local or real secret keys to source control!
# ==============================================================================

# Supabase Public API (Exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role (Server-side ONLY, never expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Gemini Vision API (For receipt and bill scanning)
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy...

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Error Monitoring & Alerts (Optional: Slack/Discord/Email Webhook URL for form failures)
ERROR_ALERT_WEBHOOK_URL=
NEXT_PUBLIC_SENTRY_DSN=

